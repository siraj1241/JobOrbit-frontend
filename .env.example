# ─── Frontend environment variables ──────────────────────────
# Copy this file to `.env` (or `.env.development`) and adjust.
#
# All variables MUST be prefixed with VITE_ to be exposed to the client.

# Base URL of the JobOrbit backend API.
# In dev, use the absolute URL of your local .NET API.
# In production, point this at your deployed backend.
VITE_API_URL=http://localhost:5087/api
