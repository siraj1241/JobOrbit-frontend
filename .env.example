# ─── Frontend environment variables ──────────────────────────
# Copy this file to `.env` (or `.env.development`) and adjust.
#
# All variables MUST be prefixed with VITE_ to be exposed to the client.

# Base URL of the JobOrbit backend API.
# - Local dev:    http://localhost:5087/api
# - Production:   https://joborbit-backend-5.onrender.com/api
VITE_API_URL=https://joborbit-backend-5.onrender.com/api
